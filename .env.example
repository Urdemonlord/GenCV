# Environment variables for apps/web (set them in the Vercel dashboard for deploys).
# The same list, with comments, lives in apps/web/.env.example.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI suggestions (optional): a key from a paid Gemini API project.
GEMINI_API_KEY=

# Shared rate limit for /api/ai (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile for /api/ai (optional; set both or neither)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
