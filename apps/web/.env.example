# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI suggestions (optional). Use a key from a paid Gemini API project: the privacy
# policy states prompts are not used to improve Google's products, which only holds there.
GEMINI_API_KEY=

# Shared rate limit for /api/ai across server instances (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile for /api/ai (optional; set both or neither)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloud sync (optional; leave empty to keep GenCV fully on-device).
# Without these the app builds and runs normally and /api/auth answers 503.
# Postgres must be reachable from Vercel (e.g. Neon); a local socket will not work.
DATABASE_URL=
# Session signing secret, at least 32 chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin, for correct cookies and redirects behind a proxy
BETTER_AUTH_URL=
